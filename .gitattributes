# Normalize text to LF everywhere so byte-exact golden files agree across Windows and macOS.
* text=auto eol=lf

# Binary art and generated assets: never convert, never diff as text.
*.png binary
*.gif binary
*.aseprite binary
*.sqlite3 binary
*.bin binary

# The runtime atlas and catalog that `cargo xtask assets` generates, compared byte for byte.
crates/terrarium-compose/assets/generated/** binary

# Golden files are compared byte for byte.
**/golden/** binary

# The art package is kept byte-for-byte as delivered; its SHA-256s are checked against
# PACKAGE-CONTENTS.json, so git must never rewrite line endings inside it.
art-assets/** -text
