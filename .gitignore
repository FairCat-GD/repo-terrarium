# Build output
/target/
/dist/
*.profraw
*.profdata

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Local harness leftovers (harnesses clean up after themselves; this catches killed runs)
/tmp/

# Reports `repo-terrarium --probe` writes into whatever directory it runs from
repo-terrarium-probe-*

# Snapshots insta proposes but nobody has accepted
*.snap.new*
*.pending-snap

# The egui memory probe's report, written into whatever directory it runs from
egui-memory-*.txt
